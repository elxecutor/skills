#!/bin/bash
# claude-cli - Talk to Claude via claude.ai
# Usage: claude-cli -c <conversation-id> "message"
#        claude-cli --list
#        claude-cli --new "title"
#        claude-cli --rename -c <conversation-id> "new name"
#        claude-cli --delete -c <conversation-id>
#        claude-cli --update-cookie

set -e

COOKIE_FILE="$HOME/.config/opencode/claude-cookie"
COOKIE="${CLAUDE_COOKIE:-}"
[[ -z "$COOKIE" && -f "$COOKIE_FILE" ]] && COOKIE=$(cat "$COOKIE_FILE")
ORG="${CLAUDE_ORG_ID:-a6dd0812-ac3a-481e-a523-298e1ee199be}"
MODEL="claude-haiku-4-5-20251001"
ACTION="chat"
CONV=""
MSG=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --cookie) COOKIE="$2"; shift 2 ;;
    --org) ORG="$2"; shift 2 ;;
    --model|-m) MODEL="$2"; shift 2 ;;
    --list) ACTION="list"; shift ;;
    --history) ACTION="history"; shift ;;
    --new) ACTION="new"; shift ;;
    --rename) ACTION="rename"; shift ;;
    --delete) ACTION="delete"; shift ;;
    --update-cookie) ACTION="update-cookie"; shift ;;
    -c) CONV="$2"; shift 2 ;;
    -h|--help)
      echo "claude-cli - Talk to Claude via claude.ai"
      echo ""
      echo "Usage:"
      echo "  claude-cli --list                    List conversations"
      echo "  claude-cli --history -c <id>         Show conversation history"
      echo "  claude-cli -c <id> \"message\"        Send a message"
      echo "  claude-cli --new \"title\"             Create a new conversation"
      echo "  claude-cli --rename -c <id> \"name\"   Rename a conversation"
      echo "  claude-cli --delete -c <id>          Delete a conversation"
      echo "  claude-cli --update-cookie           Update expired cookie"
      echo ""
      echo "Options:"
      echo "  -c ID           Conversation ID"
      echo "  --list          List recent conversations"
      echo "  --history       Show conversation history"
      echo "  --new           Create a new conversation (title optional)"
      echo "  --rename        Rename a conversation"
      echo "  --delete        Delete a conversation"
      echo "  --update-cookie Update expired cookie"
      echo "  --model M       Model (default: claude-haiku-4-5-20251001)"
      echo ""
      echo "Cookie: ~/.config/opencode/claude-cookie"
      exit 0 ;;
    *) MSG="$1"; shift ;;
  esac
done

show_cookie_error() {
  echo "Error: Cookie expired or missing" >&2
  echo "" >&2
  echo "To update:" >&2
  echo "  1. Open https://claude.ai in your browser" >&2
  echo "  2. Open DevTools → Application → Cookies → claude.ai" >&2
  echo "  3. Copy these cookies: sessionKey, cf_clearance, anthropic-device-id, lastActiveOrg" >&2
  echo "  4. Run: claude-cli --update-cookie" >&2
  echo "     Or edit: $COOKIE_FILE" >&2
  exit 1
}

case "$ACTION" in
  update-cookie)
    echo "Paste your full cookie string (from browser DevTools → Network → Request Headers → cookie):"
    read -r NEW_COOKIE
    echo "$NEW_COOKIE" > "$COOKIE_FILE"
    chmod 600 "$COOKIE_FILE"
    echo "Cookie saved to $COOKIE_FILE"
    exit 0
    ;;
esac

[[ -z "$COOKIE" ]] && show_cookie_error

# Print a readable API error to stderr. $1=HTTP code, $2=response body.
print_api_error() {
  local code="$1" body="$2" msg
  msg=$(python3 -c "
import sys,json
try:
    err=json.loads(sys.argv[1]).get('error',{})
    m=err.get('message','')
    if isinstance(m,str) and m.lstrip().startswith('{'):
        try:
            import datetime
            n=json.loads(m)
            def _reset(o):
                r=(o.get('resolved') or {})
                for cand in (r.get('resets_at'), (r.get('limit') or {}).get('resets_at')):
                    if cand: return cand
                w=((o.get('windows') or {}).get('5h') or {})
                for cand in (w.get('resets_at'), o.get('resetsAt')):
                    if cand:
                        try:
                            return datetime.datetime.fromtimestamp(int(cand),datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S+00:00')
                        except Exception:
                            return str(cand)
                return None
            r=_reset(n)
            print(('Rate limited. Resets at %s.' % r) if r else 'Rate limited.')
        except Exception:
            print(m[:300])
    elif m:
        print(str(m)[:300])
    else:
        print(json.dumps(err)[:300])
except Exception as e:
    print('could not parse error body: %s' % e)
" "$body" 2>/dev/null)
  echo "Error: claude.ai returned HTTP $code" >&2
  [[ -n "$msg" ]] && echo "$msg" >&2
}

api() {
  local resp code
  resp=$(curl -s -w "\n%{http_code}" "$1" \
    -H "cookie: $COOKIE" \
    -H "content-type: application/json" \
    -H "anthropic-client-platform: web_claude_ai" \
    -H "anthropic-device-id: $(cat /proc/sys/kernel/random/uuid)" \
    -H "user-agent: Mozilla/5.0 (X11; Linux x86_64) Chrome/152.0.0.0" \
    ${2:+-d "$2"} 2>/dev/null) || { echo "Error: network request failed" >&2; return 1; }

  code=$(tail -n1 <<<"$resp"); resp=$(sed '$d' <<<"$resp")

  # Check for auth errors
  if grep -q "Just a moment\|cf_chl_opt\|challenge-platform" <<<"$resp"; then
    show_cookie_error
  fi

  if [[ ! "$code" =~ ^2 ]]; then
    if [[ "$code" == "401" || "$code" == "403" ]]; then
      show_cookie_error
    fi
    print_api_error "$code" "$resp"
    return 1
  fi

  echo "$resp"
}

case "$ACTION" in
  new)
    TITLE="${MSG:-New conversation}"
    TITLE_JSON=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$TITLE")
    api "https://claude.ai/api/organizations/$ORG/chat_conversations" "{\"name\":$TITLE_JSON,\"model\":\"$MODEL\"}" | \
      python3 -c "
import sys,json
raw=sys.stdin.read()
if not raw.strip(): sys.exit(1)
try:
    d=json.loads(raw); print(f\"{d['uuid']}  {d.get('name','')}\")
except Exception as e:
    print(f'Error: could not parse new-conversation response: {e}',file=sys.stderr); sys.exit(1)
" || exit 1
    ;;
  rename)
    [[ -z "$CONV" ]] && { echo "Error: Use --rename -c <conversation-id> \"new name\"" >&2; exit 1; }
    [[ -z "$MSG" ]] && { echo "Error: No new name" >&2; exit 1; }
    NAME_JSON=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$MSG")
    curl -s -X PUT \
      "https://claude.ai/api/organizations/$ORG/chat_conversations/$CONV" \
      -H "cookie: $COOKIE" \
      -H "content-type: application/json" \
      -H "anthropic-client-platform: web_claude_ai" \
      -H "anthropic-device-id: $(cat /proc/sys/kernel/random/uuid)" \
      -H "user-agent: Mozilla/5.0 (X11; Linux x86_64) Chrome/152.0.0.0" \
      -d "{\"name\":$NAME_JSON}" 2>/dev/null | \
      python3 -c "
import sys,json
raw=sys.stdin.read()
if not raw.strip(): sys.exit(1)
try:
    d=json.loads(raw); print(f\"{d.get('uuid','')}  {d.get('name','')}\")
except Exception as e:
    print(f'Error: could not parse rename response: {e}',file=sys.stderr); sys.exit(1)
" || exit 1
    ;;
  delete)
    [[ -z "$CONV" ]] && { echo "Error: Use --delete -c <conversation-id>" >&2; exit 1; }
    curl -s -X DELETE \
      "https://claude.ai/api/organizations/$ORG/chat_conversations/$CONV" \
      -H "cookie: $COOKIE" \
      -H "content-type: application/json" \
      -H "anthropic-client-platform: web_claude_ai" \
      -H "anthropic-device-id: $(cat /proc/sys/kernel/random/uuid)" \
      -H "user-agent: Mozilla/5.0 (X11; Linux x86_64) Chrome/152.0.0.0" 2>/dev/null || show_cookie_error
    echo "Deleted $CONV"
    ;;
  list)
    api "https://claude.ai/api/organizations/$ORG/chat_conversations_v2?limit=20" | \
      python3 -c "
import sys,json
raw=sys.stdin.read()
if not raw.strip(): sys.exit(1)
try:
    convs=json.loads(raw).get('data',[])
    out='\n'.join(f\"{c['uuid']}  {c['name']}\" for c in convs)
    print(out if out else '(no conversations)')
except Exception as e:
    print(f'Error: could not parse conversation list: {e}',file=sys.stderr); sys.exit(1)
" || exit 1
    ;;
  history)
    [[ -z "$CONV" ]] && { echo "Error: Use --history -c <conversation-id>" >&2; exit 1; }
    api "https://claude.ai/api/organizations/$ORG/chat_conversations/$CONV?tree=True&rendering_mode=messages" | \
      python3 -c "
import sys,json
raw=sys.stdin.read()
if not raw.strip(): sys.exit(1)
try:
    data=json.loads(raw)
except Exception as e:
    print(f'Error: could not parse history response: {e}',file=sys.stderr); sys.exit(1)
msgs=data.get('chat_messages',[])
for m in msgs:
    role=m.get('sender','?')
    text=m.get('text','')
    # Also check content array
    if not text and 'content' in m:
        for c in m.get('content',[]):
            if isinstance(c,dict) and c.get('type')=='text':
                text = c.get('text','')
                break
    if text: print(f'[{role}]: {text[:500]}')
" || exit 1
    ;;
  chat)
    [[ -z "$CONV" ]] && { echo "Error: Use -c <conversation-id>" >&2; exit 1; }
    [[ -z "$MSG" ]] && { echo "Error: No message" >&2; exit 1; }
    
    UUID=$(python3 -c "import uuid; print(uuid.uuid4().hex[:24])")

    # JSON-encode the body so multi-line messages and quotes can't break it.
    BODY=$(python3 -c "import json,sys; print(json.dumps({'prompt':sys.argv[1],'parent_message_uuid':sys.argv[2],'timezone':'UTC','locale':'en-US','model':sys.argv[3],'thinking_mode':'off'}))" "$MSG" "$UUID" "$MODEL")

    TMP_RESP=$(mktemp /tmp/claude-cli.XXXXXX)
    HTTP_CODE=$(curl -s -N -o "$TMP_RESP" -w "%{http_code}" \
      "https://claude.ai/api/organizations/$ORG/chat_conversations/$CONV/completion" \
      -H "cookie: $COOKIE" \
      -H "content-type: application/json" \
      -H "accept: text/event-stream" \
      -H "anthropic-client-platform: web_claude_ai" \
      -H "anthropic-device-id: $(cat /proc/sys/kernel/random/uuid)" \
      -H "user-agent: Mozilla/5.0 (X11; Linux x86_64) Chrome/152.0.0.0" \
      -d "$BODY" 2>/dev/null) || HTTP_CODE="000"

    if grep -q "Just a moment\|cf_chl_opt\|challenge-platform" "$TMP_RESP" 2>/dev/null; then rm -f "$TMP_RESP"; show_cookie_error; fi

    if [[ ! "$HTTP_CODE" =~ ^2 ]]; then
      if [[ "$HTTP_CODE" == "401" || "$HTTP_CODE" == "403" ]]; then rm -f "$TMP_RESP"; show_cookie_error; fi
      print_api_error "$HTTP_CODE" "$(cat "$TMP_RESP")"; rm -f "$TMP_RESP"; exit 1
    fi

    python3 -c "
import sys,json
count=0
with open(sys.argv[1]) as f:
    for line in f:
        if line.startswith('data: '):
            try:
                d=json.loads(line[6:])
                if d.get('type')=='completion':
                    sys.stdout.write(d.get('completion','')); count+=1
            except Exception:
                pass
print()
if count==0:
    print('Warning: reply stream contained no completion text',file=sys.stderr)
" "$TMP_RESP" || { echo "Error: could not parse reply" >&2; rm -f "$TMP_RESP"; exit 1; }
    rm -f "$TMP_RESP"
    ;;
esac
